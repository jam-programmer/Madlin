@using Application.DataTransferObject
@using Newtonsoft.Json
<div class="navigation">
	<div class="navigation-icon-menu">
		<ul>
			@{
				var claim = User.Claims.Where(w => w.Type == "Route").FirstOrDefault();
				if (claim != null)
				{
					List<RouteDto>? routes = JsonConvert.DeserializeObject<List<RouteDto>>(claim.Value);
					if (routes != null && routes.Any())
					{
						var filteredRoutes = routes.Where(w => w.ParentId == Guid.Empty)
						.OrderBy(r => r.Order)
						.ToList();

						for (int i = 0; i < filteredRoutes.Count(); i++)
						{
							var route = filteredRoutes[i];
							<li data-toggle="tooltip" title="@route.Name" class="@(i==0?"active":"")">
								<a href="#@route.UniqueId" title="@route.Name">
									@Html.Raw(route.Icon)
								</a>
							</li>
						}
					}
				}
			}
			
		</ul>
		<ul>
			
			<li data-toggle="tooltip" title="خروج">
				<a href="/Signout" class="go-to-page">
					<i class="icon ti-power-off"></i>
				</a>
			</li>
		</ul>
	</div>
	<div class="navigation-menu-body">
		

		@{
			
			if (claim != null)
			{
				List<RouteDto>? routes =
				JsonConvert.DeserializeObject<List<RouteDto>>(claim.Value);
				if (routes != null && routes.Any())
				{
					var filteredRoutes = routes.Where(w => w.ParentId == Guid.Empty)
					.OrderBy(r => r.Order)
					.ToList();
					for (int i = 0; i < filteredRoutes.Count(); i++)
					{
						<ul id="@filteredRoutes[i].UniqueId"
							class="@(i==0?"navigation-active":"")">
							@foreach (var routeChild in routes.Where(w => w.ParentId == filteredRoutes[i].Id).OrderBy(r => r.Order))
							{
								<li><a href="@routeChild.Url"> @routeChild.Name </a></li>
							}

							

						</ul>
					}
				}
			}
		}










		
	</div>
</div>