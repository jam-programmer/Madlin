@using EndPoint_Ui.Areas.Admin.Models.Role
@model CreateRoleRouteModel
@{
    string title = "اعطای دسترسی";
    ViewData["Title"] = title;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    ViewData["PageName"] = title;

    ViewData["ControllerName"] = "نقش های کاربری";

    ViewData["Title"] = title;

    ViewData["Url"] = "/Admin/Role";
    List<RouteViewModel> routes = (List<RouteViewModel>)ViewBag.Routes;
    List<Guid> roleRoutes = (List<Guid>)ViewBag.RoleRoutes ?? new List<Guid>();
}
@section Script {
    <partial name="/Areas/Admin/Views/Shared/_ValidationScriptsPartial.cshtml" />
}

<div class="row">
    <div class="col-md-8 offset-2 mt-5">
        @if (ViewBag.Alert != null)
        {
            <div class="alert alert-warning alert-with-border alert-dismissible" role="alert">
                <i class="ti-help-alt m-r-10"></i> @ViewBag.Alert
                <button type="button" class="close" data-dismiss="alert" aria-label="بستن">
                    <i class="ti-close"></i>
                </button>
            </div>
        }

        <div class="card">
            <div class="card-body p-3">
                <h6 class="card-title">@title</h6>
                <form asp-area="admin" asp-controller="Role" asp-action="Access" method="post">
                    <div class="alert alert-info">
                        برای اعطای دسترسی ابتدا گروه را فعال نمائید؛ در صورت عدم انتخاب گروه دسترسی اعمال نمیگردد
                    </div>
                    <input type="hidden" asp-for="RoleId" value="@ViewBag.RoleId"/>
                    <div class="form-group">
                        @if (routes != null && routes.Any())
                        {
                            @foreach (var route in routes.OrderBy(o => o.Order))
                            {
                                var isChecked = roleRoutes.Any(a => a == route.Id);
                                var checkboxId = $"route_{route.Id}";
                                @if (route.ParentId == Guid.Empty)
                                {
                                    <div style="padding-right:5px;background-color:#754da3;border-radius:10px; ">
                                        <div class="custom-control custom-switch mt-3">
                                            <input type="checkbox" class="custom-control-input"
                                                   value="@route.Id"
                                                   id="@checkboxId"
                                            @(isChecked ? "checked" : "")
                                                   name="Routes">
                                            <label class="custom-control-label text-white" for="@checkboxId">
                                                @route.Name
                                                (گروه)
                                            </label>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div style="padding-right:10px;">
                                        <div class="custom-control custom-switch">
                                            <input type="checkbox" class="custom-control-input"
                                                   value="@route.Id"
                                                   id="@checkboxId"
                                            @(isChecked ? "checked" : "")
                                                   name="Routes">
                                            <label class="custom-control-label" for="@checkboxId">
                                                @route.Name
                                            </label>
                                        </div>
                                    </div>
                                }






                            }
                        }

                    </div>


                    <button type="submit" class="btn btn-primary">ثبت</button>
                    <a asp-area="admin" asp-controller="Role" asp-action="Index" class="btn btn-warning text-white">بازگشت</a>
                </form>
            </div>
        </div>

    </div>
</div>