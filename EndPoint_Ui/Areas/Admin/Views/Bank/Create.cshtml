@using Application.Common
@using EndPoint_Ui.Areas.Admin.Models.Bank
@model CreateBankModel
@{
    string title = "افزودن شماره";
    ViewData["Title"] = title;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    ViewData["PageName"] = title;

    ViewData["ControllerName"] = "بانک شماره موبایل";

    ViewData["Title"] = title;

    ViewData["Url"] = "/Admin/Bank";


}
@section Script {
    <partial name="/Areas/Admin/Views/Shared/_ValidationScriptsPartial.cshtml" />
}

<div class="row">
    <div class="col-md-6 offset-3 mt-5">
        @if (ViewBag.Alert != null)
        {
            <div class="alert alert-warning alert-with-border alert-dismissible" role="alert">
                <i class="ti-help-alt m-r-10"></i> @ViewBag.Alert
                <button type="button" class="close" data-dismiss="alert" aria-label="بستن">
                    <i class="ti-close"></i>
                </button>
            </div>
        }

        <div class="card">
            <div class="card-body">
                <h6 class="card-title">@title</h6>
                <form asp-area="admin" asp-controller="Bank"
                asp-action="Create"  method="post">
                    <div class="validation text-danger" asp-validation-summary="All"></div>

                    <div class="form-group">
                        <label>عنوان </label>
                        <input asp-for="Title" type="text" class="form-control text-left" />
                        <span class="text-danger" asp-validation-for="Title"></span>
                    </div>
                    <div class="form-group">
                        <label>شماره </label>
                        <input asp-for="PhoneNumber" type="text" class="form-control text-left" />
                        <span class="text-danger" asp-validation-for="PhoneNumber"></span>
                    </div>






                    <button type="submit" class="btn btn-primary">ثبت</button>
                    <a asp-area="admin" asp-controller="Bank" asp-action="Index" class="btn btn-warning text-white">بازگشت</a>
                </form>
            </div>
        </div>

    </div>
</div>