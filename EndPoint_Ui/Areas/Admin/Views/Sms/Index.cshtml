@using Application.Common
@using Application.Common.Extension
@using EndPoint_Ui.Areas.Admin.Models.Notification

@model PaginatedList<NotificationViewModel>
@{
    string title = "ارسال پیامک";
    ViewData["Title"] = title;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    ViewData["PageName"] = title;

    ViewData["ControllerName"] = title;

	ViewData["Title"] = "مدیریت پیامک";

    ViewData["Url"] = "/Admin/Sms";


}


<div class="row">
	<div class="col-4">
		<div class="card">
			<div class="card-body">
				<h6 class="card-title">ارسال از خط خدماتی</h6>
				<p class="card-text">
					برای ارسال پیام با این روش ابتدا باید قالب ارسال پیام را در

					<a class="text-primary" href="https://sms.ir/">
						سامانه پیامکی
				</a>
				تعریف نمائید
				</p>
				<a asp-area="Admin" asp-controller="Sms" asp-action="GeneralNumberForm"
					class="btn btn-primary text-white">فرم ارسال</a>
			</div>
		</div>
    </div>


	<div class="col-4">
		<div class="card">
			<div class="card-body">
				<h6 class="card-title">ارسال از خط اختصاصی</h6>
				<p class="card-text">
					برای ارسال پیام با این روش باید شماره اختصاصی و پلن را از

					<a class="text-primary" href="https://sms.ir/">
						سامانه پیامکی
					</a>
					خریداری نمائید
				</p>
				<a asp-area="Admin" asp-controller="Sms" asp-action="ExclusiveNumberForm"
				   class="btn btn-primary text-white">فرم ارسال</a>
			</div>
		</div>
	</div>
</div>
