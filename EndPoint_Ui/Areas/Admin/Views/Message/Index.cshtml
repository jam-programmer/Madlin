@using Application.Common
@using EndPoint_Ui.Areas.Admin.Models.Message
@model PaginatedList<MessageViewModel>
@{
    ViewData["Title"] = "پیام های ارتباطی";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    ViewData["PageName"] = "پیام های ارتباطی";

    ViewData["ControllerName"] = "پیام های ارتباطی";

    ViewData["Title"] = "لیست";
    ViewData["Url"] = "/Admin/Message";


}

@section Script {
    <script src="~/js/rest.js"></script>
    <script src="~/js/pagination.js"></script>
    <script src="~/js/sweetalert.js"></script>
    <script src="~/admin/assets/js/Message/index.js"></script>
}
<div class="row">
   
    <div class="col-12">

        <div class="card">

            <div class="card-body">
                <div class="mb-4 mt-1 row">

                    <div class="col-10">
                        <label>جستجو</label>
                        <form asp-area="Admin" asp-controller="Message" asp-action="Index" method="get" class="form-group d-flex flex-row">
                            <input type="text" value="@ViewBag.Keyword" name="keyword" class="reounded-17 form-control w-25 mx-sm-3 text-left" />
                            <button type="submit" class="btn btn-sm btn-success text-white mx-1 reounded-17"><i class="ti-search"></i></button>
                            <a asp-area="Admin" asp-controller="Message" asp-action="Index" class="btn btn-sm btn-warning text-white mx-1 reounded-17"><i class="ti-reload"></i></a>
                        </form>
                    </div>

                </div>
                <div class="table-responsive" tabindex="1" style="overflow: hidden; outline: none;">
                    <table class="table">
                        <thead>
                            <tr>

                                <th scope="col">نام و نام خانوادگی</th>
                                <th scope="col">ایمیل یا شماره تماس</th>
                                <th scope="col">تاریخ ثبت</th>
                                <th class="text-right" scope="col">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.List != null && Model.List.Any())
                            {
                                @foreach (var item in Model.List)
                                {
                                    <tr id="item_@item.Id">
                                        <td>
                                           @item.Name
                                        </td>
                                        <td>
                                            @item.Email
                                        </td>
                                        <td>
                                            @item.CreatedAt
                                        </td>
                                        <td>
                                            <a onclick="Show('@item.Message')" class="btn btn-sm btn-info text-white">نمایش پیام</a>
                                        </td>
                                        <td class="text-right">
                                            <div class="dropdown">
                                                <a href="#" class="btn btn-light btn-floating btn-icon btn-sm" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                    <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                                                </a>
                                                <div class="dropdown-menu dropdown-menu-right">
                                                  
                                                 
                                                    <a onclick="Delete('@item.Id')" class="dropdown-item">حذف</a>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }

                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer">

                @if (Model!.TotalPage > 1)
                {
                    <div id="pagination-body"
                         data-page-index="@Model.CurrentPage"
                         data-total-pages="@Model.TotalPage"
                         data-search="@ViewBag.Keyword"
                         data-path="/Admin/Message/Index">
                    </div>
                }
            </div>
        </div>
    </div>
</div>