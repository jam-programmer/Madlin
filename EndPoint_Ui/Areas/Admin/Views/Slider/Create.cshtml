@using Application.Common
@using EndPoint_Ui.Areas.Admin.Models.Slider
@model CreateSliderImageModel
@{
    string title = "ایجاد تصویر";
    ViewData["Title"] = title;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    ViewData["SliderImageName"] = title;

    ViewData["ControllerName"] = "اسلایدر";

    ViewData["Title"] = title;

    ViewData["Url"] = "/Admin/Slider";


}

@section Script {
    <script src="~/js/upload.js"></script>

    <script src="~/admin/assets/js/SliderImage/create.js"></script>
    <partial name="/Areas/Admin/Views/Shared/_ValidationScriptsPartial.cshtml" />
}

<div class="row">
    <div class="col-md-10 offset-1">
        @if (ViewBag.Alert != null)
        {
            <div class="alert alert-warning alert-with-border alert-dismissible" role="alert">
                <i class="ti-help-alt m-r-10"></i> @ViewBag.Alert
                <button type="button" class="close" data-dismiss="alert" aria-label="بستن">
                    <i class="ti-close"></i>
                </button>
            </div>
        }

        <div class="card">
            <div class="card-body">
                <h6 class="card-title">@title</h6>
                <form asp-area="admin" asp-controller="Slider" asp-action="Create"
                      enctype="multipart/form-data" method="post">
                    <div class="validation text-danger" asp-validation-summary="All"></div>

                    <div class="col-md-6 m-b-15">
                        <img id="imagePath_1" src="~/gallery/default.jpg" width="150" height="90">

                        <div class="form-group">
                            <label for="exampleFormControlFile1">تصویر </label>
                            <input asp-for="File" onchange="ChangeImage(this,1)"
                                   type="file" class="form-control-file" id="exampleFormControlFile1">
                        </div>
                    </div>




                    <button type="submit" class="btn btn-primary">ثبت</button>
                    <a asp-area="admin" asp-controller="Slider" asp-action="Index"
                       class="btn btn-warning text-white">بازگشت</a>
                </form>
            </div>
        </div>

    </div>
</div>