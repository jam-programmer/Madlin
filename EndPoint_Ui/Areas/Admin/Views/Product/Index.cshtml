@using Application.Common
@using EndPoint_Ui.Areas.Admin.Models.Product
@model PaginatedList<ProductViewModel>
@{
    string title = "محصولات";
    ViewData["Title"] = title;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    ViewData["PageName"] = title;

    ViewData["ControllerName"] = title;

    ViewData["Title"] = "لیست";

    ViewData["Url"] = "/Admin/Product";


}

@section Script {
    <script src="~/js/rest.js"></script>
    <script src="~/js/pagination.js"></script>
    <script src="~/js/sweetalert.js"></script>
    <script src="~/admin/assets/js/Product/index.js"></script>
}
<div class="row">
    <div class="col-6 mb-3">
        <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-primary text-white">
            <i class="ti-plus mr-2"></i> ایجاد محصول
        </a>
    </div>
    <div class="col-12">

        <div class="card">

            <div class="card-body">
                <div class="mb-4 mt-1 row">

                    <div class="col-10">
                        <label>جستجو</label>
                        <form asp-area="Admin" asp-controller="Product" asp-action="Index" method="get" class="form-group d-flex flex-row">
                            <input type="text" value="@ViewBag.Keyword" name="keyword" class="reounded-17 form-control w-25 mx-sm-3 text-left" />
                            <button type="submit" class="btn btn-sm btn-success text-white mx-1 reounded-17"><i class="ti-search"></i></button>
                            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-sm btn-warning text-white mx-1 reounded-17"><i class="ti-reload"></i></a>
                        </form>
                    </div>

                </div>
                <div class="table-responsive" tabindex="1" style="overflow: hidden; outline: none;">
                    <table class="table">
                        <thead>
                            <tr>

                                <th scope="col">تصویر محصول</th>
                                <th scope="col">عنوان محصول</th>
                                <th scope="col">کد محصول</th>
                                <th scope="col">دسته بندی</th>
                                <th scope="col">قیمت</th>
                                <th scope="col">موجودی</th>
                                <th class="text-right" scope="col">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.List != null && Model.List.Any())
                            {
                                @foreach (var item in Model.List)
                                {
                                    <tr id="item_@item.Id">
                                        <td>
                                            <figure class="avatar mr-3">
                                            @if (item.MainImagePath == "default.jpg")
                                            {
                                                <img src="~/gallery/default.jpg"  class="rounded-circle" alt="image">
                                                
                                            }
                                            else
                                            {
                                                   
                                                <img src="~/gallery/Product/@item.MainImagePath"  class="rounded-circle" alt="image">
                                              
                                                }
                                            </figure>
                                        </td>

                                        <td>
                                            @item.TitleFa
                                            <br />
                                            <small>@item.TitleEn</small>
                                        </td>
                                        <td>@item.ProductCode</td>
                                        <td>@item.CategoryTitleFa</td>
                                        <td>
                                            <span class="text-success"> @item.Price.ToString("N0")</span>

                                            @if (item.DiscountPrice != null)
                                            {
                                                <br />

                                                <span class="text-danger">
                                                    @item.DiscountPrice.ToString("N0")
                                                </span>
                                            }
                                        </td>
                                        <td>@item.Quantity</td>




                                        <td class="text-right">
                                            <div class="dropdown">
                                                <a href="#" class="btn btn-light btn-floating btn-icon btn-sm" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                    <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                                                </a>
                                                <div class="dropdown-menu dropdown-menu-right">
                                                    <a asp-area="Admin"
                                                       asp-controller="Feature"
                                                       asp-action="Index"
                                                       asp-route-ParentId="@item.Id"
                                                       class="dropdown-item">ویژگی های محصول</a>


                                                    <a asp-area="Admin"
                                                       asp-controller="Picture"
                                                       asp-action="Index"
                                                       asp-route-ParentId="@item.Id"
                                                       class="dropdown-item">تصاویر محصول </a>



                                                    <a asp-area="Admin"
                                                       asp-controller="Product"
                                                       asp-action="Edit"
                                                       asp-route-Id="@item.Id"
                                                       class="dropdown-item">ویرایش</a>
                                                    <a onclick="Delete('@item.Id')" class="dropdown-item">حذف</a>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }

                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer">

                @if (Model!.TotalPage > 1)
                {
                    <div id="pagination-body"
                         data-page-index="@Model.CurrentPage"
                         data-total-pages="@Model.TotalPage"
                         data-search="@ViewBag.Keyword"
                         data-path="/Admin/Product/Index">
                    </div>
                }
            </div>
        </div>
    </div>
</div>