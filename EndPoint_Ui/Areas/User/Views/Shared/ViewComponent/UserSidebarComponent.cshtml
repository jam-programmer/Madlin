@using EndPoint_Ui.Areas.User.Models
@model SidebarModel
@inject IViewLocalizer Localizer
<div class="btn-sidebar-account">
    <button data-bs-target="#mbAccount" data-bs-toggle="offcanvas">
        <i class="icon icon-squares-four"></i>
    </button>
</div>    <!-- sidebar account-->
<div class="offcanvas offcanvas-start canvas-sidebar" id="mbAccount">
    <div class="canvas-wrapper">
        <header class="canvas-header">
            <span aria-label="Close"
                  class="icon-close icon-close-popup"
                  data-bs-dismiss="offcanvas"></span>
        </header>
        <div class="canvas-body sidebar-mobile-append"></div>
    </div>
</div>
<!-- End sidebar account -->
<div class="wrap-sidebar-account">
    <div class="sidebar-account">
        <div class="account-avatar">
            <div class="image">
                <img alt="" src="~/images/avatar/user-account.jpg">
            </div>
            <h6 class="mb_4">@Model.FullName</h6>
            <div class="body-text-1">@Model.Email</div>
        </div>
        <ul class="my-account-nav">

            <li>
                <a asp-area="User" asp-controller="UserPanel" asp-action="Index" class="my-account-nav-item active">
                    <svg fill="none" height="24" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
                        <rect x="3" y="3" width="7" height="7" rx="1" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></rect>
                        <path d="M3 14H10V21H3V14Z" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                    </svg>
                    @Localizer["dashboard"]
                </a>
            </li>

            @if (User.Claims.Any(a => a.Type == "RoleAccess" && a.Value == "False"))
            {
                <li>
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="my-account-nav-item ">
                        <svg fill="none" height="24" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M3 3H21V21H3V3Z" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
                            <path d="M3 9H21" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
                            <path d="M9 21V9" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
                            <path d="M16 14V18" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
                            <path d="M14 16H18" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
                        </svg>
                        @Localizer["adminpanel"]
                    </a>
                </li>
            }


            <li>
                <a asp-area="User" asp-controller="UserPanel" asp-action="MyProfile" class="my-account-nav-item ">
                    <svg fill="none" height="24" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                        <path d="M12 11C14.2091 11 16 9.20914 16 7C16 4.79086 14.2091 3 12 3C9.79086 3 8 4.79086 8 7C8 9.20914 9.79086 11 12 11Z" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                    </svg>
                    @Localizer["profile"]
                </a>
            </li>
             <li>
                <a asp-area="User" asp-controller="UserPanel" asp-action="MyFavorites" class="my-account-nav-item ">
                    <svg class="icon" fill="none" height="24" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M20.8401 4.60987C20.3294 4.09888 19.7229 3.69352 19.0555 3.41696C18.388 3.14039 17.6726 2.99805 16.9501 2.99805C16.2276 2.99805 15.5122 3.14039 14.8448 3.41696C14.1773 3.69352 13.5709 4.09888 13.0601 4.60987L12.0001 5.66987L10.9401 4.60987C9.90843 3.57818 8.50915 2.99858 7.05012 2.99858C5.59109 2.99858 4.19181 3.57818 3.16012 4.60987C2.12843 5.64156 1.54883 7.04084 1.54883 8.49987C1.54883 9.95891 2.12843 11.3582 3.16012 12.3899L4.22012 13.4499L12.0001 21.2299L19.7801 13.4499L20.8401 12.3899C21.3511 11.8791 21.7565 11.2727 22.033 10.6052C22.3096 9.93777 22.4519 9.22236 22.4519 8.49987C22.4519 7.77738 22.3096 7.06198 22.033 6.39452C21.7565 5.72706 21.3511 5.12063 20.8401 4.60987V4.60987Z" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                    </svg>
                    @Localizer["wish"]
                </a>
            </li>
           
            <li>
                <a class="my-account-nav-item" href="/SignOut">
                    <svg fill="none" height="24" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9 21H5C4.46957 21 3.96086 20.7893 3.58579 20.4142C3.21071 20.0391 3 19.5304 3 19V5C3 4.46957 3.21071 3.96086 3.58579 3.58579C3.96086 3.21071 4.46957 3 5 3H9" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                        <path d="M16 17L21 12L16 7" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                        <path d="M21 12H9" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                    </svg>
                    @Localizer["signout"]
                </a>
            </li>
        </ul>
    </div>
</div>

