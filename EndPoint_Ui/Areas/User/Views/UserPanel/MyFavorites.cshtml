@using EndPoint_Ui.Areas.User.Models
@model IReadOnlyList<FavoriteProductViewModel>
@inject IViewLocalizer Localizer
@{
    string UserPanelTitle = CultureInfo.CurrentUICulture.Name == "en-US" ? "User Panel" : "پنل کاربری";

    string? Title = CultureInfo.CurrentUICulture.Name == "en-US" ? 
    "Favorite" : "علاقه مندی ها";
    ViewData["Title"] = Title;
    string dir = CultureInfo.CurrentUICulture.Name == "en-US" ? "ltr" : "rtl";
    Dictionary<string, string> route = new();
    route.Add("/UserPanel", UserPanelTitle!);
    route.Add("", Title!);
    var header = ValueTuple.Create(route, Title);
}
<partial name="Partial/_PageHeader" model="@header" />
<section class="flat-spacing">
    <div class="container">
       
        <div class="wrapper-control-shop gridLayout-wrapper">
            
            <div class="row">
                <div class="col-xl-12 mb-5">
                   
                    <div class="tf-grid-layout wrapper-shop tf-col-3" id="gridLayout">
                    

                        @foreach (var item in Model)
                        {

                                <div class="card-product grid" id="wish_@item.Id">
                                    <div class="card-product-wrapper">
                                        <a class="product-img" 
                                        asp-controller="Product" 
                                        asp-action="Detail" asp-route-UrlName="@item.UrlName" >

                                            <img alt="image-product" class="img-product ls-is-cached lazyloaded"
                                                 data-src="~/gallery/Product/@item.MainImagePath"
                                                 src="~/gallery/Product/@item.MainImagePath">
                                            <img alt="image-product" class="img-hover ls-is-cached lazyloaded"
                                                 data-src="~/gallery/Product/@item.HoverImagePath"
                                                 src="~/gallery/Product/@item.HoverImagePath">
                                        </a>@if (item.DiscountPrice != null)
                                        {
                                            <div class="on-sale-wrap">
                                                @if (item.Price > 0)
                                                {
                                                    <span class="on-sale-item">
                                                        @Math.Round((((decimal)item.Price - (decimal)item.DiscountPrice) / (decimal)item.Price) * 100)
                                                        ٪
                                                    </span>
                                                }
                                            </div>
                                        }
                                        <div class="list-product-btn">

                                        <a class="box-icon wishlist btn-icon-action"
                                        onclick="RemoveFromWishList('@item.Id','@dir')">
                                                <span class="icon icon-heart"></span>
                                                <span class="tooltip">علاقه مندی ها</span>
                                            </a>
                                         @*    <a aria-controls="compare" class="box-icon compare btn-icon-action" data-bs-toggle="offcanvas" href="shop-right-sidebar.html#compare">
                                                <span class="icon icon-gitDiff"></span>
                                                <span class="tooltip">مقایسه کردن</span>
                                            </a>
                                            <a class="box-icon quickview tf-btn-loading" data-bs-toggle="modal" href="shop-right-sidebar.html#quickView">
                                                <span class="icon icon-eye"></span>
                                                <span class="tooltip">نمایش سریع</span>
                                            </a> *@
                                        </div>
                                        <div class="list-btn-main">
                                            <a class="btn-main-product" 
                                           asp-controller="Product"
                                           asp-action="Detail" asp-route-UrlName="@item.UrlName">
                                                @(CultureInfo.CurrentUICulture.Name == "en-US" ? "View Product" : "مشاهده محصول")
                                            </a>
                                        </div>
                                    </div>
                                    <div class="card-product-info">
                                    <a class="title link" asp-controller="Product"
                                       asp-action="Detail" asp-route-UrlName="@item.UrlName">
                                            @(CultureInfo.CurrentUICulture.Name == "en-US" ? item.TitleEn : item.TitleFa)
                                        </a>
                                        @if (item.DiscountPrice != null)
                                        {
                                            <span class="price">
                                                <span class="old-price">
                                                    @item.Price
                                                    @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Toman" : "تومان")
                                                </span>
                                                @item.DiscountPrice  @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Toman" : "تومان")
                                            </span>

                                        }
                                        else
                                        {
                                            <span class="price">

                                                @item.Price @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Toman" : "تومان")
                                            </span>
                                        }
                                    </div>
                                </div>



                        }










                      
                    </div>
                </div>
               

            </div>
           
        </div>
    </div>
</section>

@section Script{

    <script src="~/js/nouislider.min.js" type="text/javascript"></script>
    <script src="~/js/shop.js" type="text/javascript"></script>
    <script src="~/js/rest.js" type="text/javascript"></script>
    <script src="~/js/sweetalert.js" type="text/javascript"></script>

}