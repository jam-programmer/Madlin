@using Application.Common
@model PaginatedList<EventViewModel>
@inject IViewLocalizer Localizer

@{
    string? Title = CultureInfo.CurrentUICulture.Name == "en-US" ? "Events" : "رویداد‌ها";
    ViewData["Title"] = Title;
    string dir = CultureInfo.CurrentUICulture.Name == "en-US" ? "ltr" : "rtl";
    Dictionary<string, string> route = new();
    route.Add("", Title!);
    var header = ValueTuple.Create(route, Title);
}

<partial name="Partial/_PageHeader" model="@header" />
<section class="main-content-page">
    <div class="container">
        <div class="row" dir="rtl">
            @if (Model.List != null && Model.List.Any())
            {
                @foreach (var item in Model.List)
                {
                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 offset-xl-4 offset-lg-4 text-center">
                      <a asp-controller="Event" asp-action="Detail" asp-route-Url="@item.Url">

                    @if (item.Path == "default.jpg")
                        {
                            <img src="~/gallery/default.jpg" class="img-fluid img-thumbnail" alt="image">

                        }
                        else
                        {

                            <img src="~/gallery/Event/@item.Path" class="img-fluid img-thumbnail" alt="image">

                        }
                        <h5 class="mt-3">
                            @(CultureInfo.CurrentUICulture.Name == "en-US" ? item.TitleEn : item.TitleFa)
                            </h5>
                        </a>
                        <hr/>
                    </div>
                }
            }
        </div> <div class="row mt-5">
            @if (Model!.TotalPage > 1)
            {
                <div id="pagination-body"
                     data-page-index="@Model.CurrentPage"
                     data-total-pages="@Model.TotalPage"
                     data-search="@ViewBag.Keyword"
                     data-path="/Events">
                </div>
            }

        </div>
    </div>
</section>

@section Script {
    <script src="~/js/nouislider.min.js" type="text/javascript"></script>
    <script src="~/js/shop.js" type="text/javascript"></script>
    <script src="~/js/paginationUi.js"></script>
}