<!doctype html>
@{
    string dir = CultureInfo.CurrentUICulture.Name == "en-US" ? "ltr" : "rtl";
}
<html lang="en-US" xml:lang="en-US" xmlns="http://www.w3.org/1999/xhtml">
<!--<![endif]-->
<head>
    <partial name="Partial/_HeadTags.cshtml"/>
    @await Component.InvokeAsync("MetaHeaderComponent")
    @await RenderSectionAsync("Style", false)
</head>
<body class="preload-wrapper">
    <!-- RTL -->
    <!-- <a class="btn-style-2 radius-3" href="javascript:void(0);" id="toggle-rtl"><span>RTL</span></a> -->
    <!-- /RTL  -->
    <!-- Scroll Top -->
    <button id="scroll-top">
        <svg fill="none"
             height="25"
             viewbox="0 0 24 25"
             width="24"
             xmlns="http://www.w3.org/2000/svg">
            <g clip-path="url(#clip0_15741_24194)">
                <path d="M3 11.9175L12 2.91748L21 11.9175H16.5V20.1675C16.5 20.3664 16.421 20.5572 16.2803 20.6978C16.1397 20.8385 15.9489 20.9175 15.75 20.9175H8.25C8.05109 20.9175 7.86032 20.8385 7.71967 20.6978C7.57902 20.5572 7.5 20.3664 7.5 20.1675V11.9175H3Z"
                      stroke="white"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"></path>
            </g>
            <defs>
                <clippath id="clip0_15741_24194">
                    <rect fill="white"
                          height="24"
                          transform="translate(0 0.66748)"
                          width="24"></rect>
                </clippath>
            </defs>
        </svg>
    </button>
    <!-- preload -->
    <div class="preload preload-container">
        <div class="preload-logo">
            <div class="spinner"></div>
        </div>
    </div>
    <!-- /preload -->
    <div id="wrapper" dir="@dir">
        <!-- TopBar-->
        <partial name="Partial/_TopBar.cshtml" />

        <!-- /TopBar -->
        <!-- Header -->
        <partial name="Partial/_Header.cshtml" />
        <!-- /Header -->

        @RenderBody()
        <!-- /NEWSLETTER -->
        <!-- Footer -->
        <partial name="Partial/_Footer.cshtml" />
        <!-- /Footer -->
        <!-- toolbar-bottom -->
        <partial name="Partial/_ToolbarBottom.cshtml" />
        <!-- /toolbar-bottom -->
    </div>
    <!-- search -->
    <partial name="Partial/_Search.cshtml" />
    <!-- /search -->
    <!-- modalDemo -->
    <partial name="Partial/_ModalDemo.cshtml" />
    <!-- /modalDemo -->
    <!-- MobileMenu -->
    <partial name="Partial/_MobileMenu.cshtml" />
    <!-- /MobileMenu -->
    <!-- Categories -->
    <partial name="Partial/_Categories.cshtml" />
    <!-- /Categories -->
    <!-- quickView -->
    <partial name="Partial/_QuickView.cshtml" />

    <!-- /quickView -->
    <!-- ShoppingCart -->
    <partial name="Partial/_ShoppingCart.cshtml" />
    <!-- /ShoppingCart -->
    <!-- Wishlist -->
    <partial name="Partial/_Wishlist.cshtml" />
    <!-- /wishlist -->
    <!-- SizeGuide -->
    <partial name="Partial/_SizeGuide.cshtml" />
    <!-- /size-guide -->
    <!-- Compare -->
    <partial name="Partial/_Compare.cshtml" />
    <!-- /Compare -->
    <!-- QuickAdd -->
    <partial name="Partial/_QuickAdd.cshtml" />

    <!-- /quickAdd -->
    <!-- Javascript -->
    <partial name="Partial/_Scripts.cshtml" />
    @await RenderSectionAsync("Script",false)
    @await Component.InvokeAsync("MetaFooterComponent")
</body>
</html>
