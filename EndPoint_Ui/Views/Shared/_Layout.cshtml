<body class="preload-wrapper">
    <!-- صفحه لودینگ با لوگوی بزرگ (قابل تعویض) -->
    <div class="loading-screen" id="loadingScreen">
        <div class="loader-card">
            <div class="logo-wrapper">
                <!--
                    لوگوی اپل فعلی (سفید، شفاف) — کاربر می‌تواند به راحتی src عکس را با لوگوی خودش جایگزین کند.
                    برای تعویض لوگو، مسیر src این img را به آدرس لوگوی دلخواه تغییر دهید (png, jpg, svg, webp ...).
                    لوگو بزرگ است و با کیفیت نمایش داده می‌شود.
                -->
                <img class="logo-img" id="mainLogo" src="~/gallery/Setting/1f782ee8-6cdd-48d3-a410-b2ab24fd4c08.png" alt="لوگو اپل - قابل تعویض">
                <div class="glow-ring"></div>
            </div>


            <!-- نوار پیشرفت زیبا -->
            <div class="progress-container">
                <div class="progress-bar" id="progressFill"></div>
            </div>

            <!-- انیمیشن نقطه‌ها برای جذابیت بیشتر -->
            <div class="dot-spinner">
                <span></span><span></span><span></span>
            </div>

        </div>
    </div>

    <!-- Scroll Top -->
