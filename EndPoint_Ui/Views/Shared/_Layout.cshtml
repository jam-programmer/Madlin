    <script>
        (function () {
            const loadingScreen = document.getElementById('loadingScreen');
            const mainSite = document.getElementById('wrapper');
            const countdownSpan = document.getElementById('countdownNumber');
            const progressFill = document.getElementById('progressFill');

            let timeLeft = 5;
            let intervalId = null;
            let timeoutId = null;
            let isLoaded = false;

            function finishLoading() {
                if (isLoaded) return;
                isLoaded = true;

                if (intervalId) clearInterval(intervalId);
                if (timeoutId) clearTimeout(timeoutId);

                loadingScreen.style.opacity = '0';
                loadingScreen.style.visibility = 'hidden';
                mainSite.classList.add('show');
                document.body.style.overflow = 'auto';
            }

            function updateCountdown() {
                if (countdownSpan) {
                    countdownSpan.innerText = timeLeft;
                }
                if (timeLeft <= 0) {
                    finishLoading();
                }
            }

            function tick() {
                if (timeLeft > 0) {
                    timeLeft--;
                    updateCountdown();
                }
                if (timeLeft === 0) {
                    finishLoading();
                }
            }

            function initLoading() {
                // پاک کردن تایمرهای قبلی
                if (intervalId) clearInterval(intervalId);
                if (timeoutId) clearTimeout(timeoutId);

                timeLeft = 5;
                isLoaded = false;

                // نمایش لودینگ، مخفی کردن محتوای اصلی
                loadingScreen.style.opacity = '1';
                loadingScreen.style.visibility = 'visible';
                mainSite.classList.remove('show');
                document.body.style.overflow = 'hidden';

                // تنظیم شمارنده
                if (countdownSpan) countdownSpan.innerText = '5';

                // ریست نوار پیشرفت (بدون transition لحظه‌ای)
                if (progressFill) {
                    progressFill.style.transition = 'none';
                    progressFill.style.width = '0%';
                    // force reflow
                    void progressFill.offsetWidth;
                    // فعال کردن مجدد transition
                    progressFill.style.transition = 'width 5s linear';
                    progressFill.style.width = '100%';
                }

                // شروع شمارش معکوس هر ثانیه
                intervalId = setInterval(() => {
                    tick();
                }, 1000);

                // تایمر نهایی برای اتمام حتمی بعد از ۵ ثانیه
                timeoutId = setTimeout(() => {
                    finishLoading();
                }, 5000);
            }

            initLoading();

            // دکمه ریست اختیاری
            const reloadBtn = document.getElementById('reloadHint');
            if (reloadBtn) {
                reloadBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    initLoading();
                });
            }

            window.addEventListener('beforeunload', function () {
                if (intervalId) clearInterval(intervalId);
                if (timeoutId) clearTimeout(timeoutId);
            });
        })();
    </script>
    <!-- Javascript -->
    <partial name="Partial/_Scripts.cshtml" />
    @await RenderSectionAsync("Script",false)
    @await Component.InvokeAsync("MetaFooterComponent")
</body>
