@using static EndPoint_Ui.Components.ItemPageComponent
@model FooterViewModel
@{
    string dir = CultureInfo.CurrentUICulture.Name == "en-US" ? "ltr" : "rtl";
}

<div class="footer-body">
    <div class="container" >
        <div class="row">
            <div class="col-lg-4">
                <div class="footer-infor">
                    <div class="footer-logo">
                        <a href="/">
                            <img alt="" src="~/gallery/Setting/@Model.LogoPath" width="150" height="150" />
                        </a>
                    </div>
                    <div class="footer-address">
                        <p>
                            @(CultureInfo.CurrentUICulture.Name=="en-US"?Model.AddressEn:Model.AddressFa)
                        </p>
                       
                    </div>
                    <ul class="footer-info">
                        <li>
                            <i class="icon-mail"></i>
                            <p>@Model.Email</p>
                        </li>
                        <li>
                            <i class="icon-phone"></i>
                            <p>@Model.PhoneNumber</p>
                        </li>
                    </ul>
                    <ul class="tf-social-icon">
                        <li>
                            <a class="social-madlin" href="@Model.Telegram">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24">
                                    <path fill="currentColor" d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" />
                                </svg>
                            </a>
                        </li>
                        <li>
                            <a class="social-madlin" href="@Model.WhatsApp">
                                <i class="icon icon-whatsapp"></i>
                            </a>
                        </li>
                        <li>
                            <a class="social-madlin" href="@Model.Instagram">
                                <i class="icon icon-instagram"></i>
                            </a>
                        </li>
                        <li>
                            <a class="social-madlin" href="@Model.Linkedin">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24">
                                    <path fill="currentColor" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                                </svg>
                            </a>
                        </li>
                       
                    </ul>
                </div>
            </div>
            <div class="col-lg-4" dir="@dir">
                <div class="footer-menu" dir="rtl">
                    <div class="footer-col-block" dir="rtl">
                        <div class="footer-heading text-button footer-heading-mobile">
                            @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Shortcuts" : "دسترسی سریع")
                        </div>
                        <div class="tf-collapse-content">
                            <ul class="footer-menu-list">
                                <li class="text-caption-1">
                                    <a class="footer-menu_item" href="/Products">
                                        @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Products" : "محصولات")
                                    </a>
                                </li>
                                <li class="text-caption-1">
                                    <a class="footer-menu_item" href="/Blogs">
                                        @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Blogs" : "مقالات")
                                    </a>
                                </li> <li class="text-caption-1">
                                    <a class="footer-menu_item" href="/Events">
                                        @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Events" : "رویداد ها")
                                    </a>
                                </li>
                                <li class="text-caption-1">
                                    <a class="footer-menu_item" href="/About">
                                        @(CultureInfo.CurrentUICulture.Name == "en-US" ? "About Us" : "درباره ما")
                                    </a>
                                </li>

                                <li class="text-caption-1">
                                    <a class="footer-menu_item" href="/contact-Us">
                                        @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Contact Us" : "تماس با ما")
                                    </a>
                                </li>



                                <li class="text-caption-1">
                                    <a class="footer-menu_item" href="/faq">
                                        @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Faqs" : "سوالات متداول")
                                    </a>
                                </li>


                            </ul>
                        </div>
                    </div>
                    @await Component.InvokeAsync("ItemPageComponent", new PositionModel(1, false))

                </div>
            </div>

            <div class="col-lg-4" dir="@dir">
                <div class="footer-col-block" dir="rtl">
                    <div class="footer-heading text-button footer-heading-mobile">
                        @(CultureInfo.CurrentUICulture.Name=="en-US"?"About MADLIN":"درباره مادلین")
                    </div>
                    <p>
                        @(CultureInfo.CurrentUICulture.Name == "en-US" ? Model.DescriptionEn : Model.DescriptionFa)

                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
