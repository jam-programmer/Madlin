@using static EndPoint_Ui.Components.ItemPageComponent
<div class="offcanvas offcanvas-start canvas-mb" id="mobileMenu">
    <span aria-label="Close"
          class="icon-close icon-close-popup"
          data-bs-dismiss="offcanvas"></span>
    <div class="mb-canvas-content">
        <div class="mb-body">
            <div class="mb-content-top">
                <form class="form-search" asp-controller="Product" asp-action="Products" method="get">
                    <fieldset class="text">
                        <input aria-required="true"
                               class=""
                               name="search"
                               placeholder="به دنبال چه چیزی هستید؟"
                               required=""
                               tabindex="0"
                               type="text"
                               value="" />
                    </fieldset>
                    <button class="" type="submit">
                        <svg fill="none"
                             height="24"
                             viewbox="0 0 24 24"
                             width="24"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M11 19C15.4183 19 19 15.4183 19 11C19 6.58172 15.4183 3 11 3C6.58172 3 3 6.58172 3 11C3 15.4183 6.58172 19 11 19Z"
                                  stroke="#181818"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"></path>
                            <path d="M20.9984 20.9999L16.6484 16.6499"
                                  stroke="#181818"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"></path>
                        </svg>
                    </button>
                </form>
                <ul class="nav-ul-mb" id="wrapper-menu-navigation">
                    <li class="nav-mb-item active">
                        <a href="/" class="mb-2">
                            <span>@(CultureInfo.CurrentUICulture.Name == "en-US" ? "Home" : "خانه")</span>
                        </a>
                    </li>

                    <li class="nav-mb-item mt-2">
                        <a href="/Products" class="mb-2">
                         <span>@(CultureInfo.CurrentUICulture.Name == "en-US" ? "Products" : "محصولات")</span>
                         
                        </a>
                    </li>
                    <li class="nav-mb-item mt-2 ">
                        <a href="/Blogs" class="mb-2">
                         <span>@(CultureInfo.CurrentUICulture.Name == "en-US" ? "Blogs" : "مقالات")</span>
                         
                        </a>
                    </li>
                    <li class="nav-mb-item mt-2">
                        <a href="/About" class="mb-2">
                            <span>@(CultureInfo.CurrentUICulture.Name == "en-US" ? "About Us" : "درباره ما")</span>

                        </a>
                    </li>
                    <li class="nav-mb-item mt-2">
                        <a href="/Contact" class="mb-2">
                            <span>
                                @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Contact Us " : "تماس با ما")</span>

                        </a>
                    </li>
                    @await Component.InvokeAsync("ItemPageComponent", new PositionModel(2, true))

                </ul>
            </div>
            <div class="mb-other-content">
                <div class="group-icon">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a class="site-nav-icon" href="/Userpanel">

                            @(CultureInfo.CurrentUICulture.Name == "en-US" ? "My Profile" : "پروفایل من")
                        </a>
                        <a class="site-nav-icon" href="/Signout">
                            @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Sign Out" : "خروج از حساب کاربری")
                        </a>
                    }
                    else
                    {
                        <a class="site-nav-icon" asp-controller="Identity"
                           asp-action="SignUp">

                            @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Sign Up" : "ثبت نام")
                        </a>
                        <a class="site-nav-icon" asp-controller="Identity"
                           asp-action="SignIn">
                            @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Sign In" : "ورود به حساب کاربری")
                        </a>
                    }
                </div>
                @await Component.InvokeAsync("ContactInformationComponent")
            </div>
        </div>
        <div class="mb-bottom">
            <div class="bottom-bar-language">
                <div class="tf-currencies">
              
                    <a asp-controller="Home" asp-action="ChangeLanguage" asp-area=""
                       asp-route-culture="fa-IR">      <img src="~/gallery/fa.png" width="30" height="30" />@(CultureInfo.CurrentUICulture.Name == "en-US" ? "Persian" : "فارسی")</a>
                </div>
                <div class="tf-languages">
                   
                    <a asp-controller="Home" asp-action="ChangeLanguage" asp-area=""
                       asp-route-culture="en-US">
                        <img src="~/gallery/en.png" width="30" height="30" />
                       @(CultureInfo.CurrentUICulture.Name == "en-US" ? "English" : "انگلیسی")</a>
              
                </div>
            </div>
        </div>
    </div>
</div>