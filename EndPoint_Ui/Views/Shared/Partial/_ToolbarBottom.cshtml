<div class="tf-toolbar-bottom">
    <div class="toolbar-item">
        <a href="/Products">
            <div class="toolbar-icon">
                <svg class="icon" fill="none" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.5 2.5H8.33333V8.33333H2.5V2.5ZM11.6667 2.5H17.5V8.33333H11.6667V2.5ZM2.5 11.6667H8.33333V17.5H2.5V11.6667ZM11.6667 11.6667H17.5V17.5H11.6667V11.6667Z" fill="#1A1A1A" />
                </svg>
            </div>
            <div class="toolbar-label">
                @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Products" : "محصولات")

            </div>
        </a>
    </div>
    <div class="toolbar-item">
        <a
           href="/Blogs">
            <div class="toolbar-icon">
                <svg class="icon" fill="none" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.5 4.16667H17.5V5.83333H2.5V4.16667ZM2.5 9.16667H17.5V10.8333H2.5V9.16667ZM2.5 14.1667H17.5V15.8333H2.5V14.1667Z" fill="#1A1A1A" />
                </svg>
            </div>
            <div class="toolbar-label">
                @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Blogs" : "مقالات")
            </div>
        </a>
    </div>
    <div class="toolbar-item">
        <a  href="/">
            <div class="toolbar-icon">
                <svg class="icon" fill="none" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 1.66667L18.3333 8.33333H16.6667V17.5H11.6667V12.5H8.33333V17.5H3.33333V8.33333H1.66667L10 1.66667ZM5 10V15H6.66667V10.8333H13.3333V15H15V10L10 6.25L5 10Z" fill="#1A1A1A" />
                </svg>
            </div>
            <div class="toolbar-label">
                @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Home" : "خانه")
            </div>
        </a>
    </div>
    <div class="toolbar-item">
        <a data-bs-toggle="modal" href="#search">
            <div class="toolbar-icon">
                <svg class="icon" fill="none" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12.5 11.6667H11.6667L11.4167 11.4167C12.4167 10.25 13.0833 8.66667 13.0833 6.91667C13.0833 3.5 10.3333 0.75 6.91667 0.75C3.5 0.75 0.75 3.5 0.75 6.91667C0.75 10.3333 3.5 13.0833 6.91667 13.0833C8.66667 13.0833 10.25 12.4167 11.4167 11.4167L11.6667 11.6667V12.5L16.25 17.0833L17.0833 16.25L12.5 11.6667ZM6.91667 11.6667C4.25 11.6667 2.16667 9.58333 2.16667 6.91667C2.16667 4.25 4.25 2.16667 6.91667 2.16667C9.58333 2.16667 11.6667 4.25 11.6667 6.91667C11.6667 9.58333 9.58333 11.6667 6.91667 11.6667Z" fill="#1A1A1A" />
                </svg>
            </div>
            <div class="toolbar-label">
                @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Search" : "جستجو")
            </div>
        </a>
    </div>

    <div class="toolbar-item">
        @if (User.Identity.IsAuthenticated)
        {
            <a href="/UserPanel">
                <div class="toolbar-icon">
                    <svg class="icon" fill="none" height="24" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                        <path d="M12 11C14.2091 11 16 9.20914 16 7C16 4.79086 14.2091 3 12 3C9.79086 3 8 4.79086 8 7C8 9.20914 9.79086 11 12 11Z" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                    </svg>
                </div>


                <div class="toolbar-label">
                    @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Profile" : "پروفایل")
                </div>
            </a>
        }
        else
        {
            <a href="/SignIn">
                <div class="toolbar-icon">
                    <svg class="icon" fill="none" height="24" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                        <path d="M12 11C14.2091 11 16 9.20914 16 7C16 4.79086 14.2091 3 12 3C9.79086 3 8 4.79086 8 7C8 9.20914 9.79086 11 12 11Z" stroke="#181818" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                    </svg>
                </div>
                <div class="toolbar-label">
                    @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Sign In" : "ورود به سایت")
                </div>
            </a>
        }

    </div>
</div>