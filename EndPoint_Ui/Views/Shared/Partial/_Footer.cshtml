
@{
    string dir = CultureInfo.CurrentUICulture.Name == "en-US" ? "ltr" : "rtl";
}
<footer class="footer" id="footer" dir="@dir">
    <div class="footer-wrap border-0">
       
        @await Component.InvokeAsync("FooterComponent")
        
        <div class="footer-bottom">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="footer-bottom-wrap">
                            <div class="left">
                             
                               
                                @if (CultureInfo.CurrentUICulture.Name == "en-US")
                                {
                                    <p class="text-caption-1">
                                        © @(DateTime.Now.Year) MADLIN All rights reserved.


                                        
                                    </p>



                                }
                                else
                                {

                                    <p class="text-caption-1">
                                        © @(DateTime.Now.Year) MADLIN.کلیه حقوق محفوظ است.
                                    </p>

                                }
                           
                            </div>
                            <div class="tf-payment">

                                @if (CultureInfo.CurrentUICulture.Name == "en-US")
                                {
                                    <p class="text-caption-1">
                                        Design & Development:

                                        <a href="https://darnogroup.ir/">Darano Technical & Engineering Group</a>
                                    </p>


                              
                                }else{
                                   
                                    <p class="text-caption-1">
                                        طراحی و توسعه:

                                        <a href="https://darnogroup.ir/">گروه فنی و مهندسی دارنو</a>
                                    </p>

                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>