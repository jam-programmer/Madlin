@using static EndPoint_Ui.Components.ItemPageComponent
@inject IViewLocalizer Localizer
<header class="header-default" id="header">
    <div class="container">
        <div class="row wrapper-header align-items-center">
            <div class="col-md-4 col-3 d-xl-none">
                <a aria-controls="mobileMenu"
                   class="mobile-menu"
                   data-bs-toggle="offcanvas"
                   href="home-jewelry-02.html#mobileMenu">
                    <i class="icon icon-categories"></i>
                </a>
            </div>
            @await Component.InvokeAsync("HeaderLogoComponent")
            <div class="col-xl-6 d-none d-xl-block">
                <nav class="box-navigation text-center">
                    <ul class="box-nav-ul d-flex align-items-center justify-content-center">
                        <li class="menu-item ">
                            <a class="item-link" href="/">
                                @Localizer["home"]
                            </a>
                        </li>
                        <li class="menu-item ">
                            <a class="item-link" asp-controller="Product" asp-action="Products">
                                @Localizer["products"]
                            </a>
                        </li>

                        <li class="menu-item ">
                            <a class="item-link" asp-controller="Blog" asp-action="Blogs">
                                @Localizer["blogs"]
                            </a>
                        </li>

                        <li class="menu-item ">
                            <a class="item-link" asp-controller="Home" asp-action="About">
                                @Localizer["about"]
                            </a>
                        </li>

                        <li class="menu-item ">
                            <a class="item-link" asp-controller="Home" asp-action="Contact">
                                @Localizer["contact"]
                            </a>
                        </li>
                        @await Component.InvokeAsync("ItemPageComponent", new PositionModel(2, false))





                    </ul>
                </nav>
            </div>
            <div class="col-xl-3 col-md-4 col-3">
                <ul class="nav-icon d-flex justify-content-end align-items-center">
                    <li class="nav-account">
                        <a class="nav-icon-item">
                            <svg class="icon"
                                 fill="none"
                                 height="24"
                                 viewbox="0 0 24 24"
                                 width="24"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21"
                                      stroke="#181818"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"></path>
                                <path d="M12 11C14.2091 11 16 9.20914 16 7C16 4.79086 14.2091 3 12 3C9.79086 3 8 4.79086 8 7C8 9.20914 9.79086 11 12 11Z"
                                      stroke="#181818"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"></path>
                            </svg>
                        </a>
                        <div class="dropdown-account dropdown-login">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <div class="list-group list-group-flush">
                                    <a href="/Userpanel"
                                       class="list-group-item list-group-item-action">
                                        @Localizer["userpanel"]
                                    </a>
                                    @if (User.Claims.Any(a => a.Type == "RoleAccess" && a.Value == "False"))
                                    {
                                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                                           class="list-group-item list-group-item-action">
                                            @Localizer["adminpanel"]
                                        </a>
                                    
                                    }
                                    <a href="/Signout"
                                       class="list-group-item list-group-item-action">
                                        @Localizer["signout"]
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="sub-top">
                                    <a class="btn-login" asp-controller="Identity"
                                       asp-action="SignIn">
                                        @Localizer["signin"]
                                    </a>

                                </div>
                                <p class="text-center text-secondary-2 mt-2">
                                    @if (CultureInfo.CurrentUICulture.Name == "en-US")
                                    {


                                        <a asp-controller="Identity" asp-action="SignUp">@Localizer["signup"]</a>
                                        <span dir="ltr"> @Localizer["accountquestion"]</span>
                                    }
                                    else
                                    {
                                        <span dir="rtl"> @Localizer["accountquestion"]</span>

                                        <a asp-controller="Identity"
                                           asp-action="SignUp">@Localizer["signup"]</a>
                                    }

                                </p>
                            }
                        </div>
                    </li>


                    <li class="nav-search">
                        <a class="nav-icon-item"
                           data-bs-toggle="modal"
                           href="home-jewelry-02.html#search">
                            <svg class="icon"
                                 fill="none"
                                 height="24"
                                 viewbox="0 0 24 24"
                                 width="24"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path d="M11 19C15.4183 19 19 15.4183 19 11C19 6.58172 15.4183 3 11 3C6.58172 3 3 6.58172 3 11C3 15.4183 6.58172 19 11 19Z"
                                      stroke="#181818"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"></path>
                                <path d="M21.35 21.0004L17 16.6504"
                                      stroke="#181818"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"></path>
                            </svg>
                        </a>
                    </li>
                   
                </ul>
            </div>
        </div>
    </div>
</header>