@inject IViewLocalizer Localizer
 <div class="tf-topbar style-2 line-bt">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-xl-3 d-none d-xl-block">
                <ul class="tf-social-icon style-fill">
                    @await Component.InvokeAsync("SocialComponent")
                </ul>
            </div>


            @await Component.InvokeAsync("SliderTextTopComponent")


            <div class="col-xl-3 d-none d-xl-block">
                <div class="tf-cur justify-content-end">
                    <a asp-controller="Home" asp-action="ChangeLanguage" asp-area=""
                       asp-route-culture="en-US">
                        @Localizer["En"]
                        <img src="~/gallery/en.png" width="30" height="30" />
                    </a>

                    <a asp-controller="Home" asp-action="ChangeLanguage"asp-area=""
                       asp-route-culture="fa-IR">
                        @Localizer["Fa"]
                        <img src="~/gallery/fa.png" width="30" height="30" />
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>