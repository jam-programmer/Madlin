                            <div class="content">
                               @Html.Raw((CultureInfo.CurrentUICulture.Name=="en-US"?Model.DescriptionEn:Model.DescriptionFa))
                            </div>
                            
                            <div class="bot d-flex justify-content-between gap-10 flex-wrap">
                                @await Component.InvokeAsync("BlogTagsComponent",Model.Id)
