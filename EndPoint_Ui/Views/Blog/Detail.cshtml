                                <div class="meta" dir="rtl">
                                    <div class="meta-item gap-8">
                                        <div class="icon">
                                            <i class="icon-calendar"></i>
                                        </div>
                                        <p class="body-text-1">
                                                @Model.CreatedAt
                                        </p>
                                    </div>
                                    <div class="meta-item gap-8">
                                        <div class="icon">
                                            <i class="icon-user"></i>
