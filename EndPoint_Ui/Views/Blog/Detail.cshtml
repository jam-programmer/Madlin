                            <div class="heading">
                                <ul class="list-tags has-bg">
                                    <li>
                                        <a class="link" >
                                            @(CultureInfo.CurrentUICulture.Name=="en-US"?Model.CategoryTitleEn:Model.CategoryTitleFa )
                                        </a>
                                    </li>
                                </ul>
                                <h3 class="fw-5">
                                    @(CultureInfo.CurrentUICulture.Name == "en-US" ?Model.TitleEn:Model.TitleFa )
