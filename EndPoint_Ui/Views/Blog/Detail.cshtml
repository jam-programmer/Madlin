                                    <p>

                                        @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Share this post" : "این پست را به اشتراک بگذارید")
                                        :
                                        <a onclick="copyTextToClipboard('@baseUrl.ToLower()','@dir')" class="badge color-site rounded-3 p-2">
                                            @baseUrl.ToLower()
                                        </a>
                                    </p>
                                    
                                </div>
