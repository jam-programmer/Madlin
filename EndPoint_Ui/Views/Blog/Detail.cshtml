@using Application.Common
@model BlogDetailViewModel
@inject IViewLocalizer Localizer
@{

    string? Title = CultureInfo.CurrentUICulture.Name == "en-US" ?
    Model.TitleEn : Model.TitleFa;
    ViewData["Title"] = Title;
    string dir = CultureInfo.CurrentUICulture.Name == "en-US" ? "ltr" : "rtl";
    Dictionary<string, string> route = new();
    route.Add("", Title!);
    var header = ValueTuple.Create(route, Title);

    var scheme = Context.Request.Scheme;
    var host = Context.Request.Host;
    var pathBase = Context.Request.PathBase;

    var baseUrl = $"{scheme}://{host}/Blog/Detail/{Model.UrlName}";
}

<partial name="Partial/_PageHeader" model="@header" />
<section class ="main-content-page" dir="@dir">
