@model PageViewModel
@inject IViewLocalizer Localizer
@{

    string Title = CultureInfo.CurrentUICulture.Name == "en-US" ? Model.TitleEn : Model.TitleFa;
    ViewData["Title"] = Title;
    string dir = CultureInfo.CurrentUICulture.Name == "en-US" ? "ltr" : "rtl";
    Dictionary<string, string> route = new();
    route.Add("", Title!);
    var header = ValueTuple.Create(route, Title);
}
<partial name="Partial/_PageHeader" model="@header" />

<section class="flat-spacing" dir="@dir">
    <div class="container">
       
        <div class="row">
            <div class="col-12">
                @(CultureInfo.CurrentUICulture.Name == "en-US" ? Html.Raw(Model.TextEn) : Html.Raw(Model.TextFa))

                
            </div>
        </div>
    </div>
</section>