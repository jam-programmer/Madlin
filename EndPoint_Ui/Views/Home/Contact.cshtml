@model InformationViewModel
@inject IViewLocalizer Localizer
@{

    string Title = CultureInfo.CurrentUICulture.Name == "en-US" ? "Contact Us" : "تماس با ما";
    ViewData["Title"] = Title;
    string dir = CultureInfo.CurrentUICulture.Name == "en-US" ? "ltr" : "rtl";
    Dictionary<string, string> route = new();
    route.Add("", Title!);
    var header = ValueTuple.Create(route, Title);
}
<partial name="Partial/_PageHeader" model="@header" />
@section Script {
   <script src="~/js/rest.js"></script>
   <script src="~/js/sweetalert.js"></script>
}
<section class="flat-spacing" dir="@dir">
    <div class="container">
        <div class="row">

            <div class="col-lg-8 col-xl-8 col-md-6 col-sm-12">
                <h4>
                    @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Get in Touch" : "در تماس باشید")
                </h4>
                <p class="text-secondary-2">
                    @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Use the form below to get in touch with our team" : "از فرم زیر برای تماس با تیم ما استفاده کنید")
                </p>
                <div>
                    <div class="wrap">
                        <div class="cols">
                            <fieldset class="">
                                <input class="" type="text" id="name" placeholder=" @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Your Name" : "نام و نام خانوادگی شما")" />
                            </fieldset>
                            <fieldset class="mt-3">
                                <input class="" type="text" id="email" placeholder=" @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Your Email Or Phone Number" : "ایمیل یا شماره موبایل شما")" />
                            </fieldset>
                        </div>
                        <fieldset class="mt-3">
                            <textarea id="message" rows="4" placeholder="@(CultureInfo.CurrentUICulture.Name == "en-US" ? "Your Message" : "پیام شما")" /></textarea>
                        </fieldset>
                    </div>
                    <div class="button-submit send-wrap">
                        <button class="tf-btn btn-fill" type="button" onclick="SendMessage('@dir')">
                            <span class="text text-button">
                                @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Send Message" : "ارسال پیام")
                                </span>
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-xl-4 col-md-6 col-sm-12">
                <h4> @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Information" : "اطلاعات تماس")</h4>
                <div class="mb_20">
                    <div class="text-title mb_8">@(CultureInfo.CurrentUICulture.Name == "en-US" ? "Phone" : "شماره تماس"):</div>
                    <p class="text-secondary">
                        @Model.PhoneNumber
                    </p>
                </div>
                <div class="mb_20">
                    <div class="text-title mb_8">@(CultureInfo.CurrentUICulture.Name == "en-US" ? "Email" : "پست الکترونیک"):</div>
                    <p class="text-secondary">@Model.Email</p>
                </div>
                <div class="mb_20">
                    <div class="text-title mb_8">
                        @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Address:" : "نشانی"):</div>
                    <p class="text-secondary">
                        @(CultureInfo.CurrentUICulture.Name == "en-US" ? Model.AddressEn : Model.AddressFa)
                    </p>
                </div>
                <ul class="tf-social-icon">

                    <li>
                        <a class="social-madlin" href="@Model.Telegram">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24">
                                <path fill="currentColor" d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" />
                            </svg>
                        </a>
                    </li>
                    <li>
                        <a class="social-madlin" href="@Model.WhatsApp">
                            <i class="icon icon-whatsapp"></i>
                        </a>
                    </li>
                    <li>
                        <a class="social-madlin" href="@Model.Instagram">
                            <i class="icon icon-instagram"></i>
                        </a>
                    </li>
                    <li>
                        <a class="social-madlin" href="@Model.Linkedin">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24">
                                <path fill="currentColor" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                            </svg>
                        </a>
                    </li>
               </ul>
            </div>
        </div>

    </div>
    </div>
</section>