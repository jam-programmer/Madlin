@{
    string Title = CultureInfo.CurrentUICulture.Name == "en-US" ? "Home" : "صفحه اصلی";
    ViewData["Title"] = Title;

}
@section Script{
    <script src="~/js/rest.js"></script>
    <script src="~/js/sweetalert.js"></script>

  
}
@section Style{

   @await Component.InvokeAsync("MetaTagsComponent")

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const swiper = new Swiper('.madlin-swiper', {
              
                loop: true, 
                autoplay: { 
                    delay: 3000,
                },
                pagination: { 
                    el: '.swiper-pagination',
                    clickable: true,
                },
                // navigation: { 
                //     nextEl: '.swiper-button-next',
                //     prevEl: '.swiper-button-prev',
                // },
            });
        });
    </script>
}






