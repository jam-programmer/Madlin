<!-- NEWSLETTER -->
<section class="section-newsletter">
    <div class="content">
        <h3 class="heading text-white wow fadeInUp">
          @(CultureInfo.CurrentUICulture.Name=="en-US"?"Join MADLIN's Newsletter":"در خبرنامه مادلین عضو شوید")
        </h3>
        <p class="text text-white wow fadeInUp" data-wow-delay="0.1s">
            @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Subscribe for early access to sales, new products, promotions, and more" : "برای دسترسی به فروش زودرس ، محصولات جدید ، تبلیغات و موارد دیگر عضو شوید")

        </p>
        <form accept-charset="utf-8"
             
              class="form-newsletter subscribe-form wow fadeInUp"
            
              id="subscribe-form"
              >
            <div class="subscribe-content" id="subscribe-content">
                <fieldset class="email">
                    <input aria-required="true"
                           class="subscribe-email"
                           id="subscribe-email"
                           name="email-form"
                           placeholder=" @(CultureInfo.CurrentUICulture.Name=="en-US"?
                           "Enter your email address":
                           "ایمیل خود را وارد کنید ")"
                           tabindex="0"
                           type="email" />
                </fieldset>
                <div class="button-submit">
                    <button class="subscribe-button text-btn-uppercase font-2"
                            
                            onclick="JoinToNewsletter('@(CultureInfo.CurrentUICulture.Name == "en-US" ? "ltr" :"rtl ")')"
                            type="button">
                        @(CultureInfo.CurrentUICulture.Name == "en-US" ?
                            "Submit" :
                            "ثبت ")
                    </button>
                </div>
            </div>
            <div class="subscribe-msg" id="subscribe-msg"></div>
        </form>
    </div>
</section>
