@model AboutViewModel
@inject IViewLocalizer Localizer
@{

    string Title = CultureInfo.CurrentUICulture.Name == "en-US" ? "About Us" : "درباره ما";
    ViewData["Title"] = Title;
    string dir = CultureInfo.CurrentUICulture.Name == "en-US" ? "ltr" : "rtl";
    Dictionary<string, string> route = new();
    route.Add("", Title!);
    var header = ValueTuple.Create(route, Title);
}
<partial name="Partial/_PageHeader" model="@header" />

<section class="flat-spacing" dir="@dir">
    <div class="container">
       
        <div class="terms-of-use-content">
            @if (Model.ImagePath == "default.jpg")
            {
                <img id="imagePath_1" src="~/gallery/default.jpg"
                     class="mb-3 w-100" />

            }
            else
            {
                <img id="imagePath_1"
                    src="~/gallery/Setting/@Model.ImagePath" class="mb-3 w-100"/>

            }
            @if (CultureInfo.CurrentUICulture.Name == "en-US")
            {
               
                    @Html.Raw(Model.TextEn)
                
            }
            else
            {
               
              
                    @Html.Raw(Model.TextFa)
                
            }
        </div>
    </div>
</section>